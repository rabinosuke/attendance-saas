# nginx.confのhttp {}内へ読み込まれる設定。
# ${...}は起動時に環境変数で置換する。
# $http_hostなどは、通信を処理するときにNginxが値を入れる変数。

# ブラウザから届いたUpgradeヘッダーに応じて、
# 転送先へ送るConnectionヘッダーの値を決める。
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# 公開URLから、ブラウザが接続するポート番号を取り出す。
# ポートが省略されていれば、HTTPSの標準ポート443を使う。
map "${APP_ORIGIN}" $public_port {
    ~:(?<configured_public_port>[0-9]+)$ $configured_public_port;
    default 443;
}

# サービス名に対応するIPを、Docker内のDNSへ問い合わせる。
resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
resolver_timeout 5s;

# 画面を処理する転送先。
upstream frontend_upstream {
    zone frontend_dns 64k;
    server ${FRONTEND_UPSTREAM} resolve;
}

# APIを処理する転送先。今は既存のbackendを使う。
upstream platform_upstream {
    zone platform_dns 64k;
    server ${PLATFORM_UPSTREAM} resolve;
}

# HTTP：正式なホスト名に一致しない要求の受け口。
server {
    listen 8080 default_server;
    server_name _;

    # Nginx自身の生存確認だけは受け付ける。
    location = /health/live {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 404;
    }
}

# HTTP：正式なホスト名への要求をHTTPSへ案内する。
server {
    listen 8080;
    server_name ${APP_HOST};

    location = /health/live {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 308 ${APP_ORIGIN}$request_uri;
    }
}

# HTTPS：対応する接続先名がなければ、TLS接続を拒否する。
server {
    listen 8443 ssl default_server;
    server_name _;

    ssl_reject_handshake on;
}

# HTTPS：正式なホスト名への通信を受け付ける。
server {
    listen 8443 ssl;
    server_name ${APP_HOST};

    # ブラウザへ提示する証明書。公開鍵もこの中に含まれる。
    ssl_certificate /etc/nginx/certs/tls.pem;

    # Nginx側の秘密鍵。署名に使い、ブラウザへは送らない。
    ssl_certificate_key /etc/nginx/certs/tls-key.pem;

    # HTTPSの通信方式とHostヘッダーから公開URLを組み立てる。
    set $received_public_origin "$scheme://$http_host";

    # 設定した公開URLと一致しない要求は拒否する。
    if ($received_public_origin != "${APP_ORIGIN}") {
        return 404;
    }

    # 要求本文は64KiBまで受け付ける。
    client_max_body_size 64k;

    # 本文を次に読み取るまで、最大30秒待つ。
    client_body_timeout 30s;

    # Nginxから転送先への通信設定。
    proxy_http_version 1.1;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;

    # 別の転送先への自動再送をしない。
    proxy_next_upstream off;

    # 応答をNginxの共有キャッシュへ保存しない。
    proxy_cache off;

    # 転送先から届いた応答を、まとめて待たずにブラウザへ流す。
    proxy_buffering off;

    location = /health/live {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # 内部用のURLは公開しない。
    location ~ ^/(internal|health/ready)(/|$) {
        return 404;
    }

    # 認証・共通基盤・運営のAPIはbackendへ転送する。
    location ~ ^/api/(auth|platform|operator)(/|$) {
        include /etc/nginx/snippets/proxy-headers.conf;

        proxy_set_header Connection "";
        proxy_pass http://platform_upstream;

        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
    }

    # それ以外のAPIは、まだ公開しない。
    location ~ ^/api(/|$) {
        return 404;
    }

    # Next.jsの開発中の画面自動更新接続。
    location = /_next/hmr {
        include /etc/nginx/snippets/proxy-headers.conf;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        proxy_pass http://frontend_upstream;
    }

    # その他のURLは、画面を処理するfrontendへ転送する。
    location / {
        include /etc/nginx/snippets/proxy-headers.conf;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout 60s;
        proxy_send_timeout 60s;

        proxy_pass http://frontend_upstream;
    }
}